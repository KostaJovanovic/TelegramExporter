/target/

# Portable by design: all state lives beside the executable. It holds the
# api_hash and a Telegram session key, which is a *bearer credential* — anyone
# who can read it can act as the account. It must never be committed.
TelegramExporterData/
Exports/

# Local scratch
*.log

# The parity corpus: `result.json` and `messages*.html` cut straight out of a
# real export by `tgx-parity corpus`. It is verbatim chat history from real
# people, and this repository has a CI workflow — that is, a push publishes it.
# Removing this line commits those messages, and git keeps them for good.
/reference/
